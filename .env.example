# Copy this file to .env and fill in your own Supabase project values.
# Find these in Supabase: Project Settings > API

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: shown in the app header
VITE_PROJECT_NAME=My Construction Project

# Server-side only (no VITE_ prefix, so it never reaches the browser).
# Used by api/read-docket.js to read delivery dockets. Set this in
# Vercel > Settings > Environment Variables; locally, `vercel dev` reads it from here.
ANTHROPIC_API_KEY=sk-ant-...
