# Copy this file to .env and fill in your own Supabase project values.
# Find these in Supabase: Project Settings > API

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: shown in the app header
VITE_PROJECT_NAME=My Construction Project

# Server-side only (no VITE_ prefix, so it never reaches the browser).
# Used by api/read-docket.js to read delivery dockets. Set this in
# Vercel > Settings > Environment Variables; locally, `vercel dev` reads it from here.
ANTHROPIC_API_KEY=sk-ant-...

# Weekly staff-hours email (api/hours-weekly.js, api/hours-reminder.js).
# Server-side only. SUPABASE_SERVICE_ROLE_KEY is from Supabase > Settings > API
# (service_role, keep it secret). SMTP_USER/SMTP_PASS: a Gmail address and an
# App Password (Google Account > Security > 2-Step Verification > App passwords).
# CRON_SECRET: any long random string; Vercel sends it with cron requests.
SUPABASE_SERVICE_ROLE_KEY=
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
CRON_SECRET=
# Optional overrides
# HOURS_REPORT_TO=kate@jmcconstruction.com
# HOURS_REPORT_CC=joemccormack.jmc@gmail.com
# HOURS_REMINDER_TO=joemccormack.jmc@gmail.com
# MAIL_FROM=JMC Site App <you@gmail.com>
